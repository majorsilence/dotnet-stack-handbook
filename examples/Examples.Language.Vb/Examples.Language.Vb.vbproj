<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Examples.Language.Vb</RootNamespace>
    <StartupObject>Examples.Language.Vb.Program</StartupObject>
    <!-- Inherited from Directory.Build.props but C#-only, so clear them here
         rather than let the VB compiler warn about properties it ignores. -->
    <ImplicitUsings />
    <Nullable />
    <LangVersion>latest</LangVersion>
    <!-- The book's VB listings use late-bound-free, explicitly typed code, so
         both of these can stay on. -->
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
  </PropertyGroup>

</Project>
